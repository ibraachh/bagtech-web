# /etc/systemd/system/bagtech-form.service — contact form for bagtech.az
# Settings and the SMTP password live in /etc/bagtech-form.env (root, 600), never in git.
[Unit]
Description=bagtech.az contact form (POST /api/contact -> e-mail)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /var/www/bagtech.az/deploy/form/app.py
EnvironmentFile=/etc/bagtech-form.env
DynamicUser=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target
